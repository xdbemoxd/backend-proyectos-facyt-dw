# ============================================================================
# .env.example — copiar a .env y completar con valores locales.
# NUNCA versionar .env ni usar estos valores en produccion.
#
# Backend: variable de entorno o archivo .env (python-dotenv).
# Docker Compose: lee este mismo .env para interpolar ${...}.
# ============================================================================

# --- Base de datos -----------------------------------------------------------
# Supabase: usa el connection string "Session pooler" (puerto 5432) para DDL.
# En runtime se puede usar el transaction pooler (6543); asyncpg ya configura
# statement_cache_size=0 para PgBouncer.
DATABASE_URL=postgresql+asyncpg://usuario:password@host:5432/basedatos
SCHEMA=private

# Variables usadas por docker-compose.yml para el PostgreSQL local.
# POSTGRES_PASSWORD es obligatoria: compose falla si falta (sin default).
POSTGRES_DB=proyectos_facyt
POSTGRES_USER=proyectos
POSTGRES_PASSWORD=reemplazar-por-una-password-local-fuerte
# PostgreSQL y el backend NO se publican al host: solo son accesibles dentro de
# la red de compose. El frontend (3000) es el unico puerto publicado.
FRONTEND_PORT=3000
# false evita cargar db/seeds (datos ficticios) en el arranque de compose.
SEED_DEMO_DATA=true

# --- Seguridad / JWT ---------------------------------------------------------
# Obligatoria: minimo 32 bytes aleatorios. El backend rechaza placeholders y
# claves cortas al arrancar (no se valida por request).
# Generar, por ejemplo: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=reemplazar-por-un-secreto-largo-y-aleatorio
JWT_ISSUER=proyectos-facyt-api
JWT_AUDIENCE=proyectos-facyt-frontend
JWT_ACCESS_TTL_MINUTES=60

# --- Google Identity ---------------------------------------------------------
GOOGLE_CLIENT_ID=reemplazar.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=reemplazar
# Opcional: si se define, exige el claim `hd` (dominio institucional).
GOOGLE_ALLOWED_DOMAIN=

# --- Aplicacion --------------------------------------------------------------
ENVIRONMENT=development
ENABLE_DOCS=false
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# --- Rate limiting / auditoria ----------------------------------------------
RATE_LIMIT=100/minute
LOGIN_RATE_LIMIT=10/minute
TRUST_PROXY_HEADERS=false
AUDIT_HTTP_ALL=false
# Auditoria HTTP no bloqueante: cola acotada + worker con reintentos.
# AUDIT_SYNC_WRITES=true solo para pruebas que leen audit_log de inmediato.
AUDIT_SYNC_WRITES=false
AUDIT_QUEUE_MAXSIZE=10000
AUDIT_WORKER_CONCURRENCY=2
AUDIT_BATCH_SIZE=50
AUDIT_WRITE_RETRIES=2
AUDIT_RETRY_BACKOFF_MS=200
AUDIT_RETENTION_DAYS=365

# --- Tareas programadas ------------------------------------------------------
TOKEN_CRON=reemplazar

# --- Frontend (docker compose / NextAuth) -----------------------------------
# AUTH_SECRET y NEXTAUTH_SECRET deben ser iguales en NextAuth v5 y tener al
# menos 32 bytes aleatorios. Compose falla si no estan definidas.
AUTH_SECRET=reemplazar-por-un-secreto-largo-y-aleatorio
NEXTAUTH_SECRET=reemplazar-por-un-secreto-largo-y-aleatorio
AUTH_URL=http://localhost:3000
NEXTAUTH_URL=http://localhost:3000
# Dominio institucional que el frontend valida en el formulario (opcional).
NEXT_PUBLIC_ALLOWED_EMAIL_DOMAIN=

# --- Pruebas de integracion --------------------------------------------------
# NUNCA la misma base que DATABASE_URL. Si no se define, las pruebas de
# integracion se omiten y la suite usa una URL inalcanzable a proposito.
# TEST_DATABASE_URL=postgresql+asyncpg://usuario:password@host:5432/basedatos_test
# TEST_SCHEMA=private
